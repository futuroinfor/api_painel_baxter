{% regroup paineis by pavimento as pavimentos %}

<div style="width: 100%;">
{% for grupo in pavimentos %}

    <!-- TÍTULO DO PAVIMENTO -->
    <div style="
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        padding: 6px 10px;
        margin-top: 8px;
        margin-bottom: 5px;
        background: #f3f4f6;
        border-left: 4px solid #2563eb;
        border-radius: 4px;
        box-sizing: border-box;
    ">
        <span style="
            font-size: 12px;
            font-weight: 800;
            color: #1f2937;
            text-transform: uppercase;
        ">
            {{ grupo.grouper|default:"Sem pavimento" }}
        </span>

        <span style="
            font-size: 9px;
            color: #6b7280;
            font-family: monospace;
        ">
            {{ grupo.list|length }} painel{{ grupo.list|length|pluralize }}
        </span>
    </div>

    <!-- PAINÉIS DO PAVIMENTO -->
<div style="
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    gap: 8px;
    width: 100%;
    overflow-x: auto;
    box-sizing: border-box;
">

    {% for painel in grupo.list %}

    <a href="#" class="panel-card" style="
        flex: 0 0 270px;
        width: 270px;
        min-width: 270px;
        max-width: 270px;
        box-sizing: border-box;
        padding: 8px !important;
        border-radius: 5px;
        display: block;
        background: #ffffff;
        border: 1px solid #dfe3e8;
        text-decoration: none;
    ">

        <!-- HOSTNAME -->
        <div style="
            margin-bottom: 6px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        ">
            <span style="
                font-size: 12px;
                font-weight: 700;
                color: #1f2937;
            ">
                {{ painel.hostname|escape }}
            </span>
        </div>

        <!-- STATUS -->
        <div style="
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 5px;
            margin-bottom: 6px;
        ">

            <!-- BAXTER -->
            <div style="
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 4px;
                height: 34px;
                border-radius: 4px;
                border: 1px solid;
                {% if painel.pn_baxter|upper == 'OK' %}
                    background: #f0fdf4;
                    border-color: #bbf7d0;
                    color: #16803d;
                {% else %}
                    background: #fef2f2;
                    border-color: #fecaca;
                    color: #b91c1c;
                {% endif %}
            ">
                <svg style="width: 20px; height: 20px; fill: currentColor;"
                     viewBox="0 0 24 24">
                    <path d="M21 6H3c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H3V8h18v10zM8.5 21l1.5-3h4l1.5 3h-7z"/>
                </svg>

                <span style="
                    font-size: 9px;
                    font-family: monospace;
                ">
                    BAXTER
                </span>
            </div>

            <!-- CLÍNICO -->
            <div style="
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 4px;
                height: 34px;
                border-radius: 4px;
                border: 1px solid;
                {% if painel.pn_clinico|upper == 'OK' %}
                    background: #f0fdf4;
                    border-color: #bbf7d0;
                    color: #16803d;
                {% else %}
                    background: #fef2f2;
                    border-color: #fecaca;
                    color: #b91c1c;
                {% endif %}
            ">
                <svg style="width: 20px; height: 20px; fill: currentColor;"
                     viewBox="0 0 24 24">
                    <path d="M21 6H3c-1.1 0-2 .9-2 2v10c0 1.1-.9 2-2-2V8c0-1.1.9-2-2-2zm0 12H3V8h18v10zM8.5 21l1.5-3h4l1.5 3h-7z"/>
                </svg>

                <span style="
                    font-size: 9px;
                    font-family: monospace;
                ">
                    CLÍNICO
                </span>
            </div>

        </div>

        <!-- DATAS -->
        <div style="
            display: flex;
            justify-content: space-between;
            gap: 5px;
            font-family: monospace;
            font-size: 8px;
            color: #9ca3af;
            line-height: 1.2;
        ">
            <span>
                Log: {{ painel.data_login|default:"--" }}
            </span>

            <span>
                Att: {{ painel.ultima_atualizacao|date:"H:i:s" }}
            </span>
        </div>

    </a>

    {% endfor %}

</div>


{% empty %}

    <div style="
        text-align: center;
        padding: 16px;
        background: white;
        border-radius: 4px;
        border: 1px dashed #d1d5db;
        color: #9ca3af;
        font-size: 12px;
    ">
        Nenhum painel monitorado até o momento.
    </div>

{% endfor %}

</div>